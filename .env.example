# Modèle de configuration locale — copier ce fichier en .env puis renseigner les valeurs
# (le fichier .env n'est jamais versionné)

# Clé secrète Django — à générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Mode debug — True en local uniquement, jamais en production
DEBUG=True

# URL de connexion PostgreSQL — format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/NOM_BASE
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthnorth

# Mots de passe des comptes de test créés par « python manage.py seed »
# (SEED_DOCTOR_PASSWORD est commun aux 4 médecins).
# Si une variable est vide, le compte correspondant n'est pas créé (simple avertissement).
# Un compte déjà existant n'est jamais modifié.
SEED_ADMIN_PASSWORD=
SEED_PATIENT_PASSWORD=
SEED_DOCTOR_PASSWORD=

# Stockage des documents médicaux sur Cloudflare R2 (compatible S3, bucket privé, juridiction EU).
# Les 4 variables suivantes vont ensemble :
#   - toutes vides     → documents stockés sur le disque local (dossier media/)
#   - toutes remplies  → documents stockés sur R2
#   - remplies en partie → Django refuse de démarrer (ImproperlyConfigured)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Format : https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Facultatif : préfixe des fichiers dans le bucket, différent en local et en production
# (ex. local en développement, production sur Render)
R2_LOCATION=
