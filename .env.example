# Modèle de configuration locale — copier ce fichier en .env puis renseigner les valeurs
# (le fichier .env n'est jamais versionné)

# Clé secrète Django — à générer avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Mode debug — True en local uniquement, jamais en production
DEBUG=True

# URL de connexion PostgreSQL — format : postgresql://UTILISATEUR:MOT_DE_PASSE@HÔTE:PORT/NOM_BASE
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/healthnorth

# Mots de passe des comptes de test créés par « python manage.py seed »
# (SEED_DOCTOR_PASSWORD est commun aux 4 médecins).
# Si une variable est vide, le compte correspondant n'est pas créé (simple avertissement).
# Un compte déjà existant n'est jamais modifié.
SEED_ADMIN_PASSWORD=
SEED_PATIENT_PASSWORD=
SEED_DOCTOR_PASSWORD=
